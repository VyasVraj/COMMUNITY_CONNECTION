# =============================================================================
# Community Roots — Environment Configuration Template
# =============================================================================
#
# IMPORTANT SECURITY RULES:
# - Copy this file to .env for local development
# - NEVER commit .env to Git
# - NEVER put service-role keys or secrets in frontend code
# - PUBLIC_ prefixed variables are bundled into the frontend (visible to users)
# - Variables WITHOUT PUBLIC_ are server-side only (Edge Functions, CI)
#
# =============================================================================

# =============================================================================
# SUPABASE — Public (Safe for frontend)
# =============================================================================

# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon key (safe for frontend, enforced by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# =============================================================================
# APPLICATION — Public
# =============================================================================

# Application display name
VITE_APP_NAME=Community Roots

# Application version (optional, defaults to package.json version)
VITE_APP_VERSION=0.1.0

# Application environment: development | staging | production
VITE_APP_ENV=development

# =============================================================================
# FEATURE FLAGS — Public
# =============================================================================

# Enable/disable features before they're production-ready
VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_FAMILY_TREE=false
VITE_FEATURE_COMMUNITY=false

# =============================================================================
# SERVER-SIDE ONLY — Do NOT prefix with VITE_
# (Used in Supabase Edge Functions or CI/CD — NEVER in frontend)
# =============================================================================

# Supabase service-role key — NEVER expose to frontend
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection string (for migrations and direct access)
# DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Cloudflare Turnstile site key (safe for frontend)
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Error tracking (e.g., Sentry DSN — public)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
